#!/usr/bin/env bash
# NemoClaw's CLI owns Hermes/OpenShell lifecycle; AIW only provides an entry point.
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export PATH="$HOME/.local/bin:$PATH"
export NEMOCLAW_DISABLE_TELEMETRY=1
export NEMOCLAW_NO_EXPRESS=1
# This selection is essential. Without it, NemoClaw defaults to Docker and
# rejects native Docker on WSL even when Podman is installed.
export NEMOCLAW_GATEWAY_RUNTIME=podman
# Operator functions provide the reboot guard and compact multi-sandbox UI.
source "$ROOT/bin/aiw-operator-menu.sh"

# Local, offline execution identity. The Git revision, not the release label,
# identifies the exact development code running inside this Linux distro.
show_version() {
    local release='unknown' commit branch details=''
    if command -v python3 >/dev/null 2>&1 && [[ -r "$ROOT/config/versions.json" ]]; then
        release="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["versions"]["project"])' "$ROOT/config/versions.json" 2>/dev/null)" || release='unknown'
    fi
    if command -v git >/dev/null 2>&1 && [[ -d "$ROOT/.git" ]]; then
        commit="$(git -C "$ROOT" rev-parse --short=7 HEAD 2>/dev/null)" || commit=''
        if [[ -n "$commit" ]]; then
            branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch='detached'
            details=" ($branch@$commit"
            if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=normal 2>/dev/null)" ]]; then
                details+=', dirty'
            fi
            details+=')'
        fi
    fi
    printf 'aiw-nemo %s%s\n' "$release" "$details"
}

check_runtime() {
    if [[ -n "${DOCKER_HOST:-}" || -n "${DOCKER_CONTEXT:-}" || -n "${CONTAINER_HOST:-}" ]]; then
        printf '[BLOCKED] Untrusted redirected container socket environment.\n' >&2
        printf 'Use the dedicated Nemo WSL shortcut with the normal user context.\n' >&2
        return 1
    fi
    command -v podman >/dev/null 2>&1 || {
        printf '[BLOCKED] Podman is missing. Install through AIW Ansible first.\n' >&2
        return 1
    }
    if [[ ! -S "/run/user/$(id -u)/podman/podman.sock" ]]; then
        printf '[BLOCKED] Rootless current-user podman.socket is not active.\n' >&2
        printf 'Rerun the idempotent AIW installer; never use sudo podman.\n' >&2
        return 1
    fi
    if ! systemctl --user is-active --quiet podman.socket; then
        printf '[BLOCKED] Current-user Podman socket unit is not active.\n' >&2
        return 1
    fi
}

network_check() {
    command -v python3 >/dev/null 2>&1 || {
        printf '[WARN] Python 3 missing; network inventory unavailable.\n' >&2
        return 1
    }
    python3 "$ROOT/bin/aiw-network-check.py" "$@"
}

status() {
    printf '\nNemoClaw / Hermes (separate Ubuntu environment)\n'
    show_version
    printf 'User: %s | WSL: %s\n' "$(id -un)" "${WSL_DISTRO_NAME:-native Linux}"
    printf 'NemoClaw runtime: rootless Podman (official Ubuntu packages; NOT Docker Desktop)\n'
    if command -v podman >/dev/null 2>&1; then
        podman --version || true
        printf 'Podman socket: %s\n' "$(if [[ -S "/run/user/$(id -u)/podman/podman.sock" ]]; then echo active; else echo missing; fi)"
    else
        printf 'Podman is not installed.\n'
    fi
    if command -v nemohermes >/dev/null 2>&1; then
        vendor_hermes --version || true
        printf 'NemoClaw manages sandbox status: use option 3 for its native CLI.\n'
    else
        printf 'NemoClaw Hermes CLI not yet installed. Choose option 2 after installation.\n'
    fi
    printf '\n=== Network addresses (snapshot only; no container started) ===\n'
    network_check || printf '[WARN] Network snapshot unavailable; no repair attempted.\n' >&2
    printf 'Guide: %s/docs/operator.md\n' "$ROOT"
}
onboard() {
    command -v nemohermes >/dev/null 2>&1 || {
        printf 'First install the host with the NemoClaw installer.\n' >&2
        return 1
    }
    check_runtime
    printf 'Official NemoClaw onboarding: use only for a deliberate provider/setup change, not normal restart.\n'
    printf 'GPU passthrough: DISABLED (--no-gpu). OpenRouter needs no NVIDIA CUDA/CDI.\n'
    printf 'Enter credentials ONLY in the official wizard, never in AIW or Git.\n'
    printf 'Managed host Ollama and NVIDIA GPU passthrough are disabled.\n'
    # The CPU/remote-inference profile must skip NVIDIA CDI checks even when
    # Docker advertises generic CDISpecDirs without nvidia.com/gpu devices.
    # Preserve the choice on --resume; any future GPU enablement is an
    # explicitly reviewed separate profile, not an implicit toolkit install.
    vendor_hermes onboard --no-gpu "$@"
}
connect() {
    command -v nemohermes >/dev/null 2>&1 || { printf 'NemoClaw not installed.\n' >&2; return 1; }
    local title="$1"
    [[ "$title" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Choose a simple registered sandbox name (letters, digits, - or _).\n' >&2
        return 1
    }
    sandbox_action_guard connect "$title" || return 1
    vendor_hermes "$title" connect
}
# Read the upstream registry, not a second AIW sandbox inventory.
# Selection stays in this shell only; Enter/0 always cancels safely.
select_registered_sandbox() {
    local inventory entries entry name provider model phase index choice
    local -a sandboxes=()
    SELECTED_SANDBOX=''
    command -v nemohermes >/dev/null 2>&1 || {
        printf 'NemoClaw CLI is missing; no sandbox action taken.\n' >&2
        return 1
    }
    command -v python3 >/dev/null 2>&1 || {
        printf 'python3 is missing; cannot safely parse the sandbox inventory.\n' >&2
        return 1
    }
    if ! inventory="$(vendor_hermes list --json)"; then
        printf 'Sandbox registry is unavailable. No action taken; see docs/nemoclaw-recovery.md.\n' >&2
        return 1
    fi
    if ! entries="$(printf '%s\n' "$inventory" | python3 -c '
import json, re, sys
try:
    data = json.load(sys.stdin)
    rows = data["sandboxes"]
    if isinstance(rows, dict):
        rows = [dict(name=k, **v) for k, v in rows.items() if isinstance(v, dict)]
    if not isinstance(rows, list):
        raise ValueError("sandboxes is not an array")
    seen = set()
    for item in rows:
        if not isinstance(item, dict):
            continue
        name = item.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}", name) or name in seen:
            continue
        seen.add(name)
        def safe(value):
            return str(value).replace("\t", " ").replace("\n", " ")[:72] if value is not None else "-"
        print("\t".join((name, safe(item.get("provider")), safe(item.get("model")), safe(item.get("livePhase")))))
except (ValueError, TypeError, KeyError, json.JSONDecodeError) as exc:
    print("Cannot parse upstream sandbox registry: " + str(exc), file=sys.stderr)
    sys.exit(1)
')"; then
        printf 'No sandbox selected; use official NemoClaw CLI for diagnostics.\n' >&2
        return 1
    fi
    if [[ -z "$entries" ]]; then
        printf 'No registered sandbox was found. No action taken.\n'
        return 1
    fi
    printf '\nRegistered NemoClaw sandboxes:\n'
    while IFS= read -r entry; do
        IFS=$'\t' read -r name provider model phase <<< "$entry"
        sandboxes+=("$name")
        [[ "$phase" == - || -z "$phase" ]] && phase='not checked'
        printf ' %2d) %-22s  %s / %s | phase: %s\n' "${#sandboxes[@]}" "$name" "$provider" "$model" "$phase"
    done <<< "$entries"
    printf '  0) Cancel\n'
    read -r -p 'Select sandbox number (Enter cancels): ' choice || return 1
    [[ -n "$choice" && "$choice" != 0 ]] || return 1
    if [[ ! "$choice" =~ ^[1-9][0-9]*$ || "${#choice}" -gt 6 ]]; then
        printf 'Invalid sandbox number. No action taken.\n' >&2
        return 1
    fi
    index=$((10#$choice))
    if (( index < 1 || index > ${#sandboxes[@]} )); then
        printf 'Sandbox number is not registered. No action taken.\n' >&2
        return 1
    fi
    SELECTED_SANDBOX="${sandboxes[index-1]}"
}

# Delegate to the official NemoClaw CLI, without parallel AIW state.
# Never rebuild, destroy or onboard as a side effect of a normal launch.
hermes_action() {
    local action="$1" sandbox="$2"
    [[ "$sandbox" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$ ]] || {
        printf 'Choose an existing sandbox name (letters, digits, - or _).\n' >&2
        return 2
    }
    command -v nemohermes >/dev/null 2>&1 || {
        printf '[BLOCKED] nemohermes not installed; see docs/nemoclaw-recovery.md.\n' >&2
        return 1
    }
    sandbox_action_guard "$action" "$sandbox" || return 1
    case "$action" in
        launch)  vendor_hermes launch "$sandbox" ;;
        resume)
            [[ -t 0 && -t 1 ]] || {
                printf '[BLOCKED] Hermes chat needs an interactive terminal.\n' >&2
                return 1
            }
            # Hermes owns conversation history; use the latest-session
            # selector, never an AIW session registry or stored ID.
            vendor_hermes "$sandbox" exec --tty --stdin -- hermes --resume latest ;;
        start)   vendor_hermes "$sandbox" start ;;
        stop)    vendor_hermes "$sandbox" stop ;;
        status)  vendor_hermes "$sandbox" status ;;
        recover) vendor_hermes "$sandbox" recover ;;
        *) printf 'Usage: aiw-nemo hermes [launch|resume|start|stop|status|recover] NAME\n' >&2; return 2 ;;
    esac
}

# Display a compact *filtered* view from the official status JSON.
# The full vendor status can include hundreds of policy lines and private data;
# it remains available explicitly through the chosen status action.
compact_sandbox_status() {
    local sandbox="$1" payload summary
    if ! payload="$(vendor_hermes "$sandbox" status --json 2>/dev/null)"; then
        # NemoClaw intentionally exits nonzero on unhealthy sandboxes; it may
        # still have produced a complete JSON report. Parse it regardless.
        :
    fi
    if [[ -z "$payload" ]]; then
        printf '[WARN] Upstream JSON status unavailable. Choose full status for details.\n' >&2
        return 1
    fi
    if ! summary="$(printf '%s\n' "$payload" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    if not isinstance(d, dict) or d.get("schemaVersion") != 1:
        raise ValueError("invalid status schema")
    def show(label, key):
        value = d.get(key)
        if value is not None and isinstance(value, (str, int, float, bool)):
            print(f"  {label}: {str(value)[:96]}")
    show("Sandbox", "name")
    show("Phase", "phase")
    show("Gateway", "gatewayState")
    show("Provider", "provider")
    show("Model", "model")
    if d.get("failureLayer"):
        print("  Readiness: degraded; see full vendor status")
    health = d.get("inferenceHealth")
    if isinstance(health, dict):
        for key in ("status", "kind", "state"):
            if isinstance(health.get(key), str):
                print(f"  Inference: {health[key][:60]}")
                break
except (ValueError, TypeError, json.JSONDecodeError) as exc:
    print("Cannot summarize official NemoClaw status: " + str(exc), file=sys.stderr)
    sys.exit(1)
')"; then
        printf '[WARN] Upstream JSON summary could not be parsed. Use full status.\n' >&2
        return 1
    fi
    printf '%s\n' "$summary"
}

menu() { operator_menu; }

case "${1:-menu}" in
    menu) menu ;;
    --version|version) show_version ;;
    status) status ;;
    onboard) shift; onboard "$@" ;;
    connect) shift; [[ $# -eq 1 ]] || exit 2; connect "$1" ;;
    verify) "$ROOT/install.sh" verify --profile nemoclaw-podman ;;
    network) shift; network_check "$@" ;;
    gateway) shift; [[ $# -eq 1 ]] || { printf 'Usage: aiw-nemo gateway [status|prepare|start|stop]\n' >&2; exit 2; }; gateway_action "$1" ;;
    hermes) shift; [[ $# -eq 2 ]] || { printf 'Usage: aiw-nemo hermes [launch|resume|start|stop|status|recover] NAME\n' >&2; exit 2; }; hermes_action "$1" "$2" ;;
    *) printf 'Usage: aiw-nemo [--version|menu|status|network [--sandbox NAME] [--save FILE|--compare FILE] [--probe]|gateway ACTION|onboard|connect NAME|verify|hermes ACTION NAME]\n' >&2; exit 2 ;;
esac
